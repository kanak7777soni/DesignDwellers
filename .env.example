# Admin CRM login.
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=change-this-long-random-secret

# Vercel uses this default name when one Blob store is connected to the project.
# Use it for private CRM JSON data and backups.
BLOB_READ_WRITE_TOKEN=

# Optional explicit private Blob token for CRM JSON data and backups.
CRM_BLOB_READ_WRITE_TOKEN=

# ImageKit stores public portfolio and Instagram image/video uploads.
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
