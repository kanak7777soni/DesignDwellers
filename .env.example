# Admin CRM login.
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=change-this-long-random-secret

# Vercel uses this default name when one Blob store is connected to the project.
# If you use both public media storage and private CRM storage, copy each token
# into the explicit variables below instead of using custom names like "test".
BLOB_READ_WRITE_TOKEN=

# Public Blob store token for portfolio and Instagram media/video uploads.
MEDIA_BLOB_READ_WRITE_TOKEN=

# Private Blob store token for CRM JSON data and backups.
CRM_BLOB_READ_WRITE_TOKEN=
