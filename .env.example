# Admin CRM login.
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=change-this-long-random-secret

# Public Blob store token for portfolio and Instagram media uploads.
# Vercel uses this default name when one public Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=

# Optional custom public media Blob token name if you use a custom env prefix.
MEDIA_BLOB_READ_WRITE_TOKEN=

# Private Blob store token for CRM JSON data and backups.
CRM_BLOB_READ_WRITE_TOKEN=
